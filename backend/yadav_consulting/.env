PORT=3000
NODE_ENV=development
API_VERSION=1.0
API_TITLE="Blue Collar Jobs API"
OPENAPI_SPEC_PATH=./open-api-spec.yaml
CONTROLLERS_PATH=./controllers
CONTROLLER_FILE_NAME=apiController.js
REQUEST_BODY_LIMIT=10mb
REQUEST_URL_ENCODED_EXTENDED=true
CORS_ENABLED=true
LOG_REQUESTS=true
CONTROLLER_TEMPLATE_API_VERSION=1.0
CONTROLLER_TEMPLATE_RESPONSE_VERSION=1.0
AUTO_GENERATE_CONTROLLER_TEMPLATE=true
HEALTH_CHECK_ENDPOINT=/health
API_DOCS_ENDPOINT=/api-docs
MONGO_URI=mongodb://localhost:27017/yadav_consulting